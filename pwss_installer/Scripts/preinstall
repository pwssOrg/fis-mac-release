#!/bin/bash

 # Pre-installation script: This will run before the installation starts
 
# Ask the user for their username using AppleScript

 username=$(osascript -e 'tell app "System Events" to display dialog "Please enter your username:" default answer ""' -e 'text returned of result')
 
# Ask the user for their password using AppleScript (hide input for security)

 password=$(osascript -e 'tell app "System Events" to display dialog "Please enter your password:" default answer "" with hidden answer' -e 'text returned of result')
 
# Check if the user input is empty (i.e., they didn't provide anything)

 if [ -z "$username" ] || [ -z "$password" ]; then

   echo "[ERROR] Username or password not entered. Exiting installation."

   exit 1

 fi
 
# Save the username and password to a temporary file or environment variable

 echo "Username: $username"

 echo "Password: $password"  # WARNING: It's risky to log passwords in plain text, this is just an example
 
# Save them in a temp file (Be cautious about storing passwords in plain text)

export DB_USER=$username
export DB_PASSWORD=$password

echo "password=$password" >> /tmp/user_credentials.txt
 
# Proceed with the installation after gathering user input

 echo "[INFO] Proceeding with installation..."