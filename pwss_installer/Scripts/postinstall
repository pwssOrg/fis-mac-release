#!/bin/bash
# Post-installation script

set -e  # Exit immediately if a command exits with a non-zero status
LOG_FILE="/tmp/postinstall_debug.log"

# Use argument $1 if provided, otherwise fallback to default install directory
INSTALL_DIR="${1:-/usr/local/pwss_installer}"
echo "[INFO] Installation directory = $INSTALL_DIR" >> $LOG_FILE

# Check that required files exist
if [ ! -f "$INSTALL_DIR/install_integrity_hash_macos.sh" ]; then
    echo "[ERROR] install_integrity_hash_macos.sh not found!" >> $LOG_FILE
    exit 1
fi

if [ ! -f "$INSTALL_DIR/dmg/IntegrityHash.dmg" ]; then
    echo "[ERROR] IntegrityHash.dmg not found!" >> $LOG_FILE
    exit 1
fi

# Run the main installation script
"$INSTALL_DIR/install_integrity_hash_macos.sh" >> $LOG_FILE

# Copy the DMG to /Applications
cp "$INSTALL_DIR/dmg/IntegrityHash.dmg" /Applications/ >> $LOG_FILE

echo "[INFO] Post-install complete." >> $LOG_FILE
