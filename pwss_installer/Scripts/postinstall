#!/bin/bash
# Post-installation script

LOG_FILE="/tmp/postinstall_debug.log"
exec > >(tee -a "$LOG_FILE") 2>&1
set -ex  # echo commands + exit on error

echo "[INFO] Postinstall started at $(date)"

# Use argument $1 if provided, otherwise fallback to default install directory
INSTALL_DIR="${1:-/usr/local/pwss_installer}"
echo "[INFO] Installation directory = $INSTALL_DIR"

# List contents for debugging
echo "[INFO] Listing files in $INSTALL_DIR:"
ls -la "$INSTALL_DIR"

# Check that required files exist
if [ ! -f "$INSTALL_DIR/install_integrity_hash_macos.sh" ]; then
    echo "[ERROR] install_integrity_hash_macos.sh not found!"
    exit 1
fi

if [ ! -f "$INSTALL_DIR/dmg/IntegrityHash.dmg" ]; then
    echo "[ERROR] IntegrityHash.dmg not found!"
    exit 1
fi

chmod +x "$INSTALL_DIR/install_integrity_hash_macos.sh"

# Run the main installation script
echo "[INFO] Running main install script..."
"$INSTALL_DIR/install_integrity_hash_macos.sh" || {
    echo "[ERROR] install_integrity_hash_macos.sh failed!"
    exit 1
}

# Copy the DMG to /Applications
if [ -f "$INSTALL_DIR/dmg/IntegrityHash.dmg" ]; then
    echo "[INFO] Copying IntegrityHash.dmg to /Applications"
    cp "$INSTALL_DIR/dmg/IntegrityHash.dmg" /Applications/ || {
        echo "[ERROR] Failed to copy IntegrityHash.dmg to /Applications"
        exit 1
    }
else
    echo "[WARN] DMG file not found, skipping copy"
fi

echo "[INFO] Post-install complete at $(date)"
