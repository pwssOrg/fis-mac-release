#!/bin/bash
# Pre-installation script: Stopping installation on macOS < 10.15 (Catalina)

exec 1>&2
set -e
set -x

LOG_FILE="${GITHUB_WORKSPACE:-/tmp}/preinstall_debug.log"
echo "[INFO] Preinstall started at $(date)" >> "$LOG_FILE"

# Create SSL directory
mkdir -p /usr/local/etc/ssl/private >> "$LOG_FILE"

# get macOS version
OS_VERSION=$(sw_vers -productVersion)
OS_MAJOR=$(echo "$OS_VERSION" | cut -d. -f1)
OS_MINOR=$(echo "$OS_VERSION" | cut -d. -f2)

echo "[INFO] Detected macOS version: $OS_VERSION" >> "$LOG_FILE"

# If major < 10 -> block
# If major = 10 and minor < 15 -> block
if [ "$OS_MAJOR" -lt 10 ] || { [ "$OS_MAJOR" -eq 10 ] && [ "$OS_MINOR" -lt 15 ]; }; then
    echo "[ERROR] Installation not supported on macOS < 10.15 (Catalina). Exiting." >> "$LOG_FILE"
    echo "Installation not supported on macOS < 10.15 (Catalina)."
    exit 1
fi

echo "[INFO] macOS version OK, proceeding installation." >> "$LOG_FILE"

# ====================================================================
# CHECK AND INSTALL HOMEBREW (preinstall)
# ====================================================================

# Hitta “riktig användare” att installera Homebrew för
if [ -n "${SUDO_USER:-}" ]; then
    REAL_USER="$SUDO_USER"
else
    REAL_USER=$(whoami)
fi

USER_HOME=$(eval echo "~$REAL_USER")
echo "[INFO] Installing Homebrew for user: $REAL_USER"

# Kontrollera om brew redan finns
if sudo -u "$REAL_USER" command -v brew >/dev/null 2>&1; then
    echo "[INFO] Homebrew already installed. Updating..."
    sudo -u "$REAL_USER" brew update
else
    echo "[INFO] Homebrew not found. Installing..."
    sudo -u "$REAL_USER" /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

    # Lägg till Homebrew i PATH för användaren
    if [[ -d "/opt/homebrew/bin" ]]; then
        # Apple Silicon
        echo 'eval "$(/opt/homebrew/bin/brew shellenv)"' >> "$USER_HOME/.zprofile"
        sudo -u "$REAL_USER" /bin/bash -c 'eval "$(/opt/homebrew/bin/brew shellenv)"'
    elif [[ -d "/usr/local/bin" ]]; then
        # Intel
        echo 'eval "$(/usr/local/bin/brew shellenv)"' >> "$USER_HOME/.zprofile"
        sudo -u "$REAL_USER" /bin/bash -c 'eval "$(/usr/local/bin/brew shellenv)"'
    fi
fi

 echo "[INFO] Homebrew installed! proceeding installation." >> "$LOG_FILE"


# ====================================================================
# CHECK HOMEBREW
# ====================================================================

# ====================================================================
# DETECT REAL USER
# ====================================================================
if [ -n "${SUDO_USER:-}" ]; then
    REAL_USER="$SUDO_USER"
else
    REAL_USER=$(whoami)
fi

USER_HOME=$(eval echo "~$REAL_USER")
echo "[INFO] Running postinstall as user: $REAL_USER"

# ====================================================================
# DETERMINE HOME BREW PATH
# ====================================================================
BREW_BIN=""
if [[ -d "/opt/homebrew/bin" ]]; then
    # Apple Silicon
    BREW_BIN="/opt/homebrew/bin/brew"
elif [[ -d "/usr/local/bin" ]]; then
    # Intel
    BREW_BIN="/usr/local/bin/brew"
fi

# ====================================================================
# JAVA INSTALLATION
# ====================================================================
if [[ "${INSTALL_JAVA:-true}" == "true" ]]; then
    echo "[INFO] Installing OpenJDK 25..."
    "$BREW_BIN" install openjdk@25 || true
    "$BREW_BIN" link --force --overwrite openjdk@25 || true
else
    echo "[INFO] Skipping Java installation."
fi

java -version || echo "[WARN] Java not installed or not linked."

# ====================================================================
# INSTALL POSTGRESQL
# ====================================================================
if ! command -v psql &>/dev/null; then
    echo "[INFO] PostgreSQL not found — installing version 17..."
    "$BREW_BIN" install postgresql@17
else
    echo "[INFO] PostgreSQL already installed."
fi

