#!/bin/bash
# Pre-installation script
exec 1>&2
set -x
set -e
LOG_FILE="/tmp/preinstall_debug.log"

# Function to prompt user locally
prompt_user() {
    DB_USER=$(osascript -e 'tell app "System Events" to display dialog "Please enter your username:" default answer ""' -e 'text returned of result')
    DB_PASSWORD=$(osascript -e 'tell app "System Events" to display dialog "Please enter your password:" default answer "" with hidden answer' -e 'text returned of result')
    
    if [ -z "$DB_USER" ] || [ -z "$DB_PASSWORD" ]; then
        echo "[ERROR] Username or password not entered. Exiting installation." >> $LOG_FILE
        exit 1
    fi
}

# Detect if running in GitHub Actions
if [ "$GITHUB_ACTIONS" = "true" ]; then
    echo "[INFO] Running in GitHub Actions CI environment." >> $LOG_FILE
    DB_USER="${DB_USER:-ci_user}"
    DB_PASSWORD="${DB_PASSWORD:-ci_password}"
else
   
        # Only prompt if terminal/GUI is available
        if [ -t 0 ]; then
            prompt_user
        else
            echo "[ERROR] No DB_USER/DB_PASSWORD set and no GUI available." >> $LOG_FILE
            exit 1
        fi
    fi

# Export credentials for subsequent scripts
export DB_USER
export DB_PASSWORD

echo "[INFO] DB_USER=$DB_USER" >> $LOG_FILE
echo "[INFO] Pre-install complete." >> $LOG_FILE
