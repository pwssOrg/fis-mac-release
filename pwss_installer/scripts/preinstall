#!/bin/bash
# Pre-installation script: Stopping installation on macOS < 10.15 (Catalina)

exec 1>&2
set -e
set -x

LOG_FILE="${GITHUB_WORKSPACE:-/tmp}/preinstall_debug.log"
echo "[INFO] Preinstall started at $(date)" >> "$LOG_FILE"

# Create SSL directory
mkdir -p /usr/local/etc/ssl/private >> "$LOG_FILE"

# get macOS version
OS_VERSION=$(sw_vers -productVersion)
OS_MAJOR=$(echo "$OS_VERSION" | cut -d. -f1)
OS_MINOR=$(echo "$OS_VERSION" | cut -d. -f2)

echo "[INFO] Detected macOS version: $OS_VERSION" >> "$LOG_FILE"

# If major < 10 -> block
# If major = 10 and minor < 15 -> block
if [ "$OS_MAJOR" -lt 10 ] || { [ "$OS_MAJOR" -eq 10 ] && [ "$OS_MINOR" -lt 15 ]; }; then
    echo "[ERROR] Installation not supported on macOS < 10.15 (Catalina). Exiting." >> "$LOG_FILE"
    echo "Installation not supported on macOS < 10.15 (Catalina)."
    exit 1
fi

echo "[INFO] macOS version OK, proceeding installation." >> "$LOG_FILE"

# ====================================================================
# CHECK HOMEBREW
# ====================================================================

if command -v brew >/dev/null 2>&1; then
    echo "Homebrew is already installed."
    echo "Updating Homebrew..." 
    brew update >> "$LOG_FILE"
else
    echo "Homebrew not found. Installing..." >> "$LOG_FILE"
     export NONINTERACTIVE=1
    # Install Homebrew (non-interactive)
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
 
    # Add Homebrew to PATH depending on architecture
    if [[ -d "/opt/homebrew/bin" ]]; then
        # Apple Silicon
        echo 'eval "$(/opt/homebrew/bin/brew shellenv)"' >> ~/.zprofile
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -d "/usr/local/bin" ]]; then
        # Intel mac
        echo 'eval "$(/usr/local/bin/brew shellenv)"' >> ~/.zprofile
        eval "$(/usr/local/bin/brew shellenv)"
    fi
fi

# ====================================================================
# JAVA INSTALLATION
# ====================================================================
if [[ "$INSTALL_JAVA" == "true" ]]; then
  echo "[INFO] Installing OpenJDK 25..." >> "$LOG_FILE"
  brew install openjdk@25 || true
  brew link --force --overwrite openjdk@25 || true
else
  echo "[INFO] Skipping Java installation." >> "$LOG_FILE"
fi

java -version || echo "[WARN] Java not installed or not linked." >> "$LOG_FILE"

# ====================================================================
# INSTALL POSTGRESQL
# ====================================================================
if ! command -v psql &>/dev/null; then
  echo "[INFO] PostgreSQL not found — installing version 17..." >> "$LOG_FILE"
  brew install postgresql@17 >> "$LOG_FILE"
fi
