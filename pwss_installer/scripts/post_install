#!/bin/bash
# Post-installation script

set -e  # Stop script on error

username=$(osascript -e 'tell app "System Events" to display dialog "Ange ditt användarnamn:" default answer ""' -e 'text returned of result')
 
# Använd användarnamnet i installationen

echo "Användarnamn är: $username"
 
echo "[INFO] Installation script running..."
 
# Controll  installation path existence

 if [ -z "$1" ]; then

   echo "[ERROR] No installation directory specified!"

   exit 1

 fi
 
# Controll if neccaccacy  files exists

 if [ ! -f "$1/install_integrity_hash_macos.sh" ]; then

   echo "[ERROR] install_integrity_hash_macos.sh not found!"

   exit 1

 fi
 
if [ ! -f "$1/dmg/IntegrityHash.dmg" ]; then

   echo "[ERROR] IntegrityHash.dmg not found!"

   exit 1

 fi
 
echo "[INFO] Run install_integrity_hash_macos.sh"

 "$1/install_integrity_hash_macos.sh"
 
echo "[INFO] Copy IntegrityHash.dmg to /Applications..."

 sudo cp "$1/dmg/IntegrityHash.dmg" /Applications/
 
echo "[INFO] Installation Complete!"