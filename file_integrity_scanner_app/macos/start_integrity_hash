# -------------------------------------------------------------------
# Set integrity_hash_app_folder based on the app's location
# -------------------------------------------------------------------
# The script will be executed from within the MacOS folder of the .app bundle.
# We need to find the root directory of the app.
integrity_hash_app_folder="$(dirname "$(realpath "$0")")/.."

# Ensure the app folder is correctly detected
if [ ! -d "$integrity_hash_app_folder" ]; then
    echo "[ERROR] Unable to detect IntegrityHash.app folder."
    exit 1
fi

# -------------------------------------------------------------------
# Load environment variables from ~/.zshrc
# -------------------------------------------------------------------
if [ -f "$HOME/.zshrc" ]; then
    # Only load exports, ignore aliases/functions
    set -a
    source "$HOME/.zshrc"
    set +a
fi

# -------------------------------------------------------------------
# Functions
# -------------------------------------------------------------------

# Function to check SHA-256 hash integrity of a file
check_file_hash() {
    local file_path="$1"
    local expected_hash="$2"

    # Calculate SHA-256 hash of the file
    actual_hash=$(shasum -a 256 "$file_path" | awk '{print $1}')

    if [ "$actual_hash" != "$expected_hash" ]; then
        echo "Hash mismatch! The file may be tampered or incorrect."
        echo "Expected: $expected_hash"
        echo "Actual:   $actual_hash"
        exit 1  # Exit with an error code if hashes don't match
    else
        echo "SHA-256 hash matches for $file_path"
    fi
}

# Function to start the local backend server in the background
start_local_server_in_background() {
    echo "[INFO] Checking if PostgreSQL is running on port 26556..."

    # Check if PostgreSQL is already running on the specified port
    if lsof -i tcp:26556 >/dev/null 2>&1; then
        echo "[INFO] PostgreSQL is already running on port 26556."
    else
        echo "[INFO] Starting local PostgreSQL server on port 26556..."
        
        brew services restart postgresql@17
    fi

    # Check file integrity of the backend JAR file
    backend_file_path="${integrity_hash_app_folder}/Resources/local_backend/File-Integrity-Scanner-1.9.jar"
    backend_expected_hash="6680617e08b280ce3912f5ffa6929693cb120956f78263f6438c5bc9c2a8e5c8"
    check_file_hash "$backend_file_path" "$backend_expected_hash"

    # Start the backend Java application
    echo "[INFO] Starting local backend Java app..."
    java -jar "$backend_file_path" &
    backend_pid=$!
    echo "[INFO] Local backend started with PID $backend_pid"
}

# Function to start the frontend app
start_frontend_app() {
    # Check file integrity of the frontend JAR file
    frontend_file_path="${integrity_hash_app_folder}/Resources/frontend/integrity_hash-1.2.3.jar"
    frontend_expected_hash="e04ca51dde652cc70db6cdb96e0baca591e3bdc76dafd117cb21804a23c9e5d8"
    check_file_hash "$frontend_file_path" "$frontend_expected_hash"

    # Start the frontend Java app
    echo "[INFO] Starting frontend app..."
    cd "${integrity_hash_app_folder}/Resources/frontend" || exit 1
    java -jar "$frontend_file_path"
}

# -------------------------------------------------------------------
# Main Execution
# -------------------------------------------------------------------

# Start local backend server and frontend app
start_local_server_in_background
start_frontend_app
